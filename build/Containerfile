ARG GO_VERSION=1.27.3
FROM docker.io/library/golang:${GO_VERSION} AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/superego ./cmd/superego

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/superego /superego
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/superego"]
